# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Leave unset on Vercel preview deployments — the app will use the in-memory
# demo user store automatically when DATABASE_URL is absent.
DATABASE_URL="postgresql://postgres:password@localhost:5432/adhikarpath_db?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# In NextAuth v5, AUTH_SECRET is also accepted (preferred name).
AUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# After setting these, also set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# ─── Microsoft Entra ID / Azure AD OAuth (optional) ───────────────────────────
# Create an app registration at https://portal.azure.com/
# After setting these, also set NEXT_PUBLIC_MICROSOFT_AUTH_ENABLED=true
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
NEXT_PUBLIC_MICROSOFT_AUTH_ENABLED="false"

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="AdhikarPath"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
